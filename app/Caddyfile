{
	admin off
	persist_config off
	auto_https off
}

# This is the deployment. Railway's service root is app/, which was not obvious
# from inside the repo — there was an identical Dockerfile and Caddyfile at the
# root that looked like the deployment and had not served a request in months.
# The proof is this file: cache headers added at the root never appeared on the
# live site, and the moment the same rules were added here they did. The root
# pair has been deleted; do not add one back without checking which directory
# Railway builds from, because an edit there is silently a no-op.
:{$PORT:3000} {
	encode gzip
	root * /srv

	# Vite writes a content hash into every filename under /assets, so one of
	# those URLs can never mean anything else. Cache them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else keeps its name across deploys — index.html, sw.js, the
	# manifest, and every narration clip — and the live site has been sending no
	# Cache-Control at all for them. With no header a browser falls back to
	# heuristic caching, roughly a tenth of the file's age, so a returning child
	# is served a stale index.html naming last month's asset hashes. Worse, the
	# same applied to sw.js, so the browser never re-fetched it, never saw the
	# new service worker, and the app could not fix itself.
	@unhashed {
		not path /assets/*
	}
	header @unhashed Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
