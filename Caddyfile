{
	admin off
	persist_config off
	auto_https off
}

:{$PORT:3000} {
	encode gzip
	root * /srv

	# Vite writes a content hash into every filename under /assets, so one of
	# those URLs can never mean anything else. Cache them for a year.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Everything else keeps its name across deploys — index.html, sw.js, the
	# manifest, and every narration clip — and this server was sending no
	# Cache-Control at all for them. With no header a browser falls back to
	# heuristic caching, roughly a tenth of the file's age, so a returning
	# child was served a stale index.html naming last month's asset hashes.
	# Worse, the same applied to sw.js, so the browser never re-fetched it,
	# never saw the new service worker, and never updated anything: the app
	# could not fix itself. These have to be revalidated on every load.
	@unhashed {
		not path /assets/*
	}
	header @unhashed Cache-Control "no-cache"

	try_files {path} /index.html
	file_server
}
